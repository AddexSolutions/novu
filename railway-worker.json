{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "libs/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      ".npmrc"
    ]
  },
  "deploy": {
    "startCommand": "pm2-runtime start dist/main.js -i max",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
