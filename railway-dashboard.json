{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/dashboard/dockerfile",
    "watchPatterns": [
      "apps/dashboard/**",
      "libs/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      ".npmrc"
    ]
  },
  "deploy": {
    "startCommand": "http-server dist -p 4000 -a 0.0.0.0",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
